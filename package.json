{
  "name": "rms-launcher",
  "version": "5.1.8",
  "description": "RMS GRAPHICS Launcher",
  "main": "main.js",
  "scripts": {
    "prestart": "node -e \"const f=require('fs'),p=require('path'),d=p.join(process.env.APPDATA||'','rms-launcher');['remote-config.json','status-cache.json'].forEach(x=>f.rmSync(p.join(d,x),{force:true}));['Cache','Code Cache','GPUCache','GPUPersistentCache'].forEach(x=>f.rmSync(p.join(d,x),{recursive:true,force:true}))\"",
    "start": "electron .",
    "build": "node scripts/obfuscate-release.js nsis",
    "build:dir": "node scripts/obfuscate-release.js dir",
    "build:portable": "node scripts/obfuscate-release.js portable",
    "prerelease": "node scripts/git-tag-release.js",
    "release": "node scripts/obfuscate-release.js release"
  },
  "author": "RMS GRAPHICS",
  "license": "ISC",
  "build": {
    "appId": "com.rmsgraphics.launcher",
    "productName": "RMS Graphics Launcher",
    "artifactName": "RMS-Graphics-Launcher-Setup-${version}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "config.js",
      "index.html",
      "music/**/*",
      "image/**/*",
      "icon1.ico",
      "icon1.png",
      "logo1.png",
      "unrar-worker.js",
      "download-worker.js",
      "native-unrar.js",
      "ui-file.js",
      "nightbright-files.js",
      "normalbright-files.js",
      "discord-presence.js",
      "launcher-update.js",
      "pure-mode.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon1.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "include": "installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "RMS Graphics Launcher",
      "language": "1048",
      "installerIcon": "icon1.ico",
      "uninstallerIcon": "icon1.ico",
      "installerHeaderIcon": "icon1.ico",
      "uninstallDisplayName": "RMS Graphics Launcher",
      "installerSidebar": "installerSidebar.bmp",
      "uninstallerSidebar": "uninstallerSidebar.bmp",
      "installerHeader": "installerHeader.bmp",
      "deleteAppDataOnUninstall": true
    },
    "asarUnpack": [
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "UnRAR.exe"
        ]
      },
      {
        "from": "unlock-rms.ps1",
        "to": "unlock-rms.ps1"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Gabi199797",
        "repo": "rms-launcher",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.10.2",
    "electron-builder": "^26.15.3",
    "javascript-obfuscator": "^4.1.1"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.3.9",
    "megajs": "^1.3.0",
    "node-unrar-js": "^2.0.2"
  }
}
